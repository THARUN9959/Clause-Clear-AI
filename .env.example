# ClauseClear AI - Environment Variables Example

# PRIMARY (1st): Gemini API
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# FALLBACK (2nd): DeepSeek API -- used when Gemini fails or quota runs out
# Get your key from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# FALLBACK (3rd): OpenAI API -- used when Gemini + DeepSeek both fail
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# FALLBACK (4th): Anthropic/Claude API -- last resort if all above fail
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Flask
FLASK_SECRET_KEY=

# Optional: set to "true" to enable Flask debug mode
FLASK_DEBUG=false

# AI Model overrides (optional -- defaults are set in config.py)
# Uncomment and change to override:
# GEMINI_MODEL=gemini-2.5-flash-lite-preview-06-17
# DEEPSEEK_MODEL=deepseek-chat          # use deepseek-reasoner for R1
# OPENAI_MODEL=gpt-4o-mini
# CLAUDE_MODEL=claude-haiku-4-5-20251001
